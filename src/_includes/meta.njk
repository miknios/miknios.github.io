{% set metaParts = [item.data.company, item.data.subtitle, item.data.years] | select %}
{% if item.data.role or metaParts.length %}
<p class="project-meta">
    {%- if item.data.role %}<b>{{ item.data.role }}</b>{% if metaParts.length %} · {% endif %}{% endif -%}
    {{ metaParts | join(" · ") }}
</p>
{% endif %}
