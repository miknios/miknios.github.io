<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} – {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ site.description }}">
    {% if robots %}
    <meta name="robots" content="{{ robots }}">
    {% else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {% endif %}

    {# How the site looks when a link to it is shared #}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.title }}">
    <meta property="og:description" content="{{ site.description }}">
    <meta property="og:url" content="{{ site.url }}/">
    <meta property="og:image" content="{{ site.url }}{{ images.share.src }}">
    <meta property="og:image:width" content="{{ images.share.width }}">
    <meta property="og:image:height" content="{{ images.share.height }}">
    <meta property="og:image:alt" content="Portrait photo of Mikołaj Wójcik">
    <meta name="twitter:card" content="summary">

    <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap">
    <link rel="stylesheet" href="/styles.css?v={{ assetVersion.css }}">
</head>

<body>

    <header>
        <div class="menu">
            <h1>Mikołaj Wójcik</h1>
            {# Each link's address matches the id of a page in index.njk, "info" is shown first #}
            <nav aria-label="Pages">
                <ul>
                    <li><a href="/#works">works</a></li>
                    {% if page.url == "/" %}
                    <li><a class="active" href="/#info" aria-current="page">info</a></li>
                    {% else %}
                    <li><a href="/#info">info</a></li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    </header>

    <main>
        {{ content | safe }}
    </main>

    <footer>
        <div>© {{ year }} Mikołaj Wójcik</div>
        {% include "contact-links.njk" %}
    </footer>

    <script src="/js/script.js?v={{ assetVersion.js }}"></script>

</body>

</html>
